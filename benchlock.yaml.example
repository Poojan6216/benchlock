# Benchlock configuration. Copy to `benchlock.yaml`, or run `benchlock init` to have
# one written from whatever eval framework you already use.
version: 1

# The false-alarm budget for the whole monitoring process, not per run. Because the
# tests are anytime-valid, this holds no matter how many times you look.
alpha: 0.05

# REQUIRED. The range your rubric emits. Benchlock normalises to [0,1] internally and
# keeps the raw value; an undeclared or out-of-range score is an error, not a warning.
score_scale: [1, 5]

min_runs: 8     # no verdict is attempted before this many runs
min_obs: 30     # minimum judged items in a run

system:
  adapter: promptfoo          # jsonl | promptfoo | inspect_ai | deepeval
  path: ./evals/results/

anchor:
  # The control group: items the system under test never touches, re-scored by the judge
  # every run. If these move, only the judge can have moved them.
  mode: frozen-self           # frozen-self (default, needs no labels) | human | replicate
  n: 260                      # size it with `benchlock plan --target-shift 0.05`
  cadence: 1                  # re-score anchors every N runs
  selection: stratified       # stratified over score decile and item tag
  noise_replicates: 5         # K, measured once at baseline
  seed: 0                     # pinned, so selection is reproducible

judge:
  provider: anthropic
  model: claude-sonnet-5
  rubric: ./evals/rubric.md

  # Leave `params` out entirely unless you need to override something. The adapter's own
  # defaults are chosen to work with the models it names, and current Anthropic models
  # REJECT `temperature` and `top_p` with a 400 — `thinking` and `output_config.effort`
  # replaced them. Whatever you write here is hashed into the judge pin, so changing it
  # is a judge change and requires `benchlock rebaseline` (Hard Rule 8).
  # params:
  #   max_tokens: 16
  #   thinking: { type: disabled }
  #   output_config: { effort: low }

  # Provider-side response caching can serve the same judge reply for the same anchor
  # prompt run after run, which makes the anchor stream read as perfectly flat while the
  # judge drifts — measured as a 100% attack success in the adversarial suite. This puts
  # a per-run nonce in the anchor prompt to defeat it. It is OFF by default because it
  # changes the prompt the judge sees; turn it on if your provider caches.
  cache_busting_nonce: false

gate:
  # A judge change must NOT fail your build. It must tell you to re-baseline.
  fail_on: [system, both]
  warn_on: [indeterminate]
